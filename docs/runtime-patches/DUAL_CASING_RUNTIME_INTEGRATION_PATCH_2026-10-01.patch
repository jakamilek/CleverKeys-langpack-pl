+data class CaseVariantCatalog(
+    val entries: List<CaseVariantSet>,
+) {
+    private val byKey: Map<String, CaseVariantSet> = entries.associateBy { it.key }
+
+    init {
+        require(byKey.size == entries.size) { "case-variant keys must be unique" }
+    }
+
+    fun get(surface: String): CaseVariantSet? =
+        byKey[surface.lowercase(java.util.Locale.ROOT)]
+
+    fun keys(): Set<String> = byKey.keys
