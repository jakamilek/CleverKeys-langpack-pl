ext":"Przy bramie stoi duży"},{"ids":[5095,31885,7684,10557,2022,11668,10517,1899,1051,27304,16466,3857],"text":"Przy miedzy poruszyły się długie uszy. Z trawy wybiegł"},{"ids":[27666,1024,5766,2757,6370,3421,8452,1899,14469,1046,2531,2092,2937],"text":"Rejestr dotyczy osób podpisujących umowę. Jedną z nich jest pan"},{"ids":[14312,19698,41842,7967],"text":"Rodzice wybrali córce imię"},{"ids":[21925,16194,4836,1899,1049,25462,30047],"text":"Rozmawialiśmy długo. W dokumencie widnieje"},{"ids":[35151,1007,36049,7996,1899,2823,10945,17704,17193,2022],"text":"Rozmawiamy o drapieżnikach. Najbliżej kamery zatrzymał się"},{"ids":[35151,1007,10890,15589,1899,2359,5903,18876,2507],"text":"Rozmawiamy o miastach wojewódzkich. Na liście pozostała jeszcze"},{"ids":[35151,1007,14507,6370,5922,8452,1899,1049,28487,2093,9813,30047],"text":"Rozmawiamy o osobie podpisującej umowę. W rubryce nazwisko widnieje"},{"ids":[10651,5766,11600,13692,1899,4327,9813,12905],"text":"Rozmowa dotyczy autora dokumentu. Jego nazwisko brzmi"},{"ids":[3311,2176,4220,37923,1019],"text":"Rzeczy spakowałem w"},{"ids":[36781],"text":"Róża"},{"ids":[17870],"text":"Sowa"},{"ids":[8546,22487,8878,12230,1899,12028,15224,19400,32470,7967],"text":"Sprawdzamy listę dziewcząt. Obok daty urodzenia zapisano imię"},{"ids":[8546,22487,9528,13327,1899,2359,4988,6572,5040,2022,2937],"text":"Sprawdzamy nazwiska świadków. Na końcu listy znajduje się pan"},{"ids":[29376,2508,3451,12385,1009,11741,2267,12657,1947],"text":"Sprawdziłem wszystkie połączenia i chciałem już wyjść,"},{"ids":[8546,8464,25543,23248,1899,1049,9611,2124,2185,9813],"text":"Sprawdzono tożsamość świadka. W dowodzie ma nazwisko"},{"ids":[16842,12802,9813,4405,4280,11723,1899,3169,2730,2937],"text":"Szef podał nazwisko nowego księgowego. Jest nim pan"},{"ids":[16616,2545,43744,1998,6665],"text":"Termin można przesunąć na poniedziałek"},{"ids":[2498,5502,3469,1947,1011,1997,17374,32066,1899,1049,28487,2093,9813,10070,2890],"text":"To dane osoby, a nie opis