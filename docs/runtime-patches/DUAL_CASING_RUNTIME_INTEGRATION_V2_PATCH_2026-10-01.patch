+package tribixbite.cleverkeys.casing
+
+import java.util.Locale
+
+/**
+ * Projects one ranked lexical slate into a display slate.
+ *
+ * A matching lexical key gets primary + alternate surfaces with the same
+ * lexical score and the same source index. The alternate is presentation-only.
+ */
+data class CaseVariantProjection(
+    val words: List<String>,
+    val scores: List<Int>,
+    val sourceIndices: List<Int>,
+)
+
+class CaseVariantProjector(
+    private val resolver: CaseVariantResolver = CaseVariantResolver(),
+) {
+    fun project(
+        words: List<String>,
+        scores: List<Int>,
+        catalog: CaseVariantCatalog,
+        preferences: Map<String, CaseVariantPreference> = emptyMap(),
+    ): CaseVariantProjection {
+        require(words.size == scores.size) { "words and scores must have equal size" }
+
+        val projectedWords = ArrayList<String>(words.size * 2)
+        val projectedScores = ArrayList<Int>(scores.size * 2)
+        val sourceIndices = ArrayList<Int>(words.size * 2)
+
+        for (index in words.indices) {
+            val variants = catalog.get(words[index])
+            if (variants == null) {
+                projectedWords.add(words[index])
+                projectedScores.add(scores[index])
+                sourceIndices.add(index)
+                continue
+            }
+
+            val selection = resolver.resolve(
+                variants = variants,
+                preference = preferences[variants.key.lowercase(Locale.ROOT)]
+                    ?: CaseVariantPreference(),
+            )
+            projectedWords.add(selection.primary)
+            projectedScores.add(scores[index])
+            sourceIndices.add(index)
+            projectedWords.add(selection.alternate)
+            projectedScores.add(scores[index])
+            sourceIndices.add(index)
+        }
+
+        return CaseVariantProjection(
+            words = projectedWords,
+            scores = projectedScores,
+            sourceIndices = sourceIndices,
+        )
+    }
+}
