+package tribixbite.cleverkeys.casing
+
+import java.util.Locale
+
+/**
+ * In-memory preference tracker scoped to the audited experiment catalog.
+ *
+ * Persistence is deliberately outside this first experiment.
+ */
+class CaseVariantPreferenceTracker(
+    private val catalog: CaseVariantCatalog,
+) {
+    private val preferences = mutableMapOf<String, CaseVariantPreference>()
+
+    fun get(key: String): CaseVariantPreference =
+        preferences[key.lowercase(Locale.ROOT)] ?: CaseVariantPreference()
+
+    fun observe(surface: String): CaseVariantPreference {
+        val variants = catalog.get(surface) ?: return get(surface)
+        val key = variants.key.lowercase(Locale.ROOT)
+        val lower = key
+        val capitalized = key.replaceFirstChar {
+            if (it.isLowerCase()) it.titlecase(Locale.ROOT) else it.toString()
+        }
+        val current = preferences[key] ?: CaseVariantPreference()
+        val next = when (surface) {
+            lower -> current.copy(lowercaseUses = current.lowercaseUses + 1)
+            capitalized -> current.copy(capitalizedUses = current.capitalizedUses + 1)
+            else -> current
+        }
+        preferences[key] = next
+        return next
+    }
+}
