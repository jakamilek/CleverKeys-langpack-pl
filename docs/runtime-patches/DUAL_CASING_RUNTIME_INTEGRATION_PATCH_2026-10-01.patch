+package tribixbite.cleverkeys.casing
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+class CaseVariantProjectionTest {
+
+    private val catalog = CaseVariantCatalog(
+        listOf(
+            CaseVariantSet("malina", "malina", "Malina"),
+            CaseVariantSet("łódź", "łódź", "Łódź"),
+            CaseVariantSet("warszawa", "Warszawa", "warszawa"),
+        )
+    )
+
+    @Test
+    fun oneLexicalCandidateBecomesPrimaryPlusAlternate() {
+        val result = CaseVariantProjector().project(
+            words = listOf("malina", "dom"),
+            scores = listOf(700, 100),
+            catalog = catalog,
+        )
+
+        assertThat(result.words).containsExactly("malina", "Malina", "dom").inOrder()
+        assertThat(result.scores).containsExactly(700, 700, 100).inOrder()
+        assertThat(result.sourceIndices).containsExactly(0, 0, 1).inOrder()
+    }
+
+    @Test
+    fun learnedCapitalizedPreferenceChangesPrimaryButKeepsAlternate() {
+        val result = CaseVariantProjector().project(
+            words = listOf("Malina"),
+            scores = listOf(900),
+            catalog = catalog,
+            preferences = mapOf(
+                "malina" to CaseVariantPreference(
+                    lowercaseUses = 2,
+                    capitalizedUses = 8,
+                )
+            ),
+        )
+
+        assertThat(result.words).containsExactly("Malina", "malina").inOrder()
+        assertThat(result.scores).containsExactly(900, 900).inOrder()
+    }
+
+    @Test
+    fun allThreeInitialExperimentCasesRemainReachable() {
+        val result = CaseVariantProjector().project(
+            words = listOf("malina", "łódź", "Warszawa"),
+            scores = listOf(300, 200, 100),
+            catalog = catalog,
+        )
+
+        assertThat(result.words).containsExactly(
+            "malina", "Malina",
+            "łódź", "Łódź",
+            "Warszawa", "warszawa",
+        ).inOrder()
+    }
+
+    @Test
+    fun nonVariantWordsStayUntouched() {
+        val result = CaseVariantProjector().project(
+            words = listOf("bardo", "dom"),
+            scores = listOf(200, 100),
+            catalog = catalog,
+        )
+
+        assertThat(result.words).containsExactly("bardo", "dom").inOrder()
+        assertThat(result.sourceIndices).containsExactly(0, 1).inOrder()
+    }
+
+    @Test
+    fun trackerNeedsObservedEvidenceBeforeSwitching() {
+        val tracker = CaseVariantPreferenceTracker()
+        repeat(4) { tracker.observe("Malina") }
+
+        val set = CaseVariantSet("malina", "malina", "Malina")
+        val result = CaseVariantResolver().resolve(
+            set,
+            tracker.get("malina"),
+        )
+
+        assertThat(result.primary).isEqualTo("malina")
+
+        repeat(4) { tracker.observe("Malina") }
+        val balanced = CaseVariantResolver().resolve(set, tracker.get("malina"))
+        assertThat(balanced.primary).isEqualTo("malina")
+
+        tracker.observe("Malina")
+        val switched = CaseVariantResolver().resolve(set, tracker.get("malina"))
+        assertThat(switched.primary).isEqualTo("Malina")
+    }
+}
